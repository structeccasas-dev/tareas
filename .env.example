# Base de datos Postgres — usar una instancia propia de este proyecto,
# sin compartir con ninguna otra aplicación.
DATABASE_URL=

# Secreto para firmar la cookie de sesión (JWT). Generar uno propio, por ejemplo:
# openssl rand -base64 32
SESSION_SECRET=

# Notificaciones push (Web Push). Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secreto para proteger /api/cron/due-tasks — usarlo como header
# Authorization: Bearer <valor> al configurar el cron job (ej. cron-job.org).
CRON_SECRET=

# Usadas únicamente por "npm run seed:admin" para crear el primer usuario admin.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@tareas.com
ADMIN_PASSWORD=
